server {
    listen ${PORT};
    server_name _;
    client_max_body_size 25m;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
    }

    location /admin/ {
        proxy_pass ${BACKEND_URL};
    }

    location /static/ {
        proxy_pass ${BACKEND_URL};
    }

    location /media/ {
        proxy_pass ${BACKEND_URL};
    }
}

