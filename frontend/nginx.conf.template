server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
    }

    location /admin/ {
        proxy_pass ${BACKEND_URL};
    }

    location /static/ {
        proxy_pass ${BACKEND_URL};
    }

    location /media/ {
        proxy_pass ${BACKEND_URL};
    }
}

